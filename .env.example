# ===============================================
# Convexa AI Backend - Environment Configuration
# Copy this file to .env or configure your system
# environment variables accordingly.
# NEVER commit real API keys or secrets to git.
# ===============================================

# Groq LLM API Key (used for Executive Briefing synthesis)
GROQ_API_KEY=your_groq_api_key_here

# Database Configuration (Neon PostgreSQL)
DB_URL=jdbc:postgresql://your-neon-db.neon.tech/convexa_db?sslmode=require
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI Processing Service & Auth
AI_SERVICE_URL=http://127.0.0.1:8000
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
